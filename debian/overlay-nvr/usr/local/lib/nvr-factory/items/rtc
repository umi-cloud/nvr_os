#!/bin/bash
# RTC:rtc0 必须是有纽扣电池备电的那颗(rk3566 SATA 板是外挂 HYM8563,RK809 内置那颗无备电,
# 断电一夜即丢;rv1126b 板是 SoC 内置 RTC,CR1220 直接供 RTC_AVDD),能写入、读回一致、在走时。
# 掉电保持这里测不出(要断电很久),靠老化后开机核对时间
. /usr/local/lib/nvr-factory/common.sh
r=/sys/class/rtc/rtc0
[ -d $r ] || { echo "no rtc0"; exit 1; }
name=$(cut -d' ' -f1 $r/name)
case "$(board)" in
rv1126b-nvr-sata) want=rtc-rockchip ;;
*) want=hym8563 ;;
esac
case "$name" in *$want*) ;; *) echo "rtc0 is $name, expected $want (battery-backed)"; exit 1 ;; esac
hwclock --systohc >&2 || { echo "$name write failed"; exit 1; }
a=$(cat $r/since_epoch); sleep 2; b=$(cat $r/since_epoch)
d=$(( $(date +%s) - b ))
[ "${d#-}" -le 2 ] || { echo "$name read-back off by ${d}s"; exit 1; }
[ $((b - a)) -ge 1 ] && [ $((b - a)) -le 3 ] || { echo "$name not ticking ($((b - a))s in 2s)"; exit 1; }
echo "$name write/read ok, ticking"
