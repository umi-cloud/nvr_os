#!/bin/bash
# 内存:容量对得上 BOM(缺颗粒/DDR training 降容会少一截)+ 一轮短 memtester
. /usr/local/lib/nvr-factory/common.sh
mb=$(( $(awk '/^MemTotal:/{print $2}' /proc/meminfo) / 1024 ))
[ "$mb" -ge "$DDR_MIN_MB" ] || { echo "size ${mb}MB < ${DDR_MIN_MB}MB"; exit 1; }
memtester "${DDR_TEST_MB}M" "$DDR_TEST_LOOPS" >&2 || { echo "memtester failed (${mb}MB)"; exit 1; }
echo "${mb}MB, memtester ${DDR_TEST_MB}M x${DDR_TEST_LOOPS} ok"
