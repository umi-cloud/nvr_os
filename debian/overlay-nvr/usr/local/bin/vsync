#!/bin/sh
# vsync 启动包装 —— 组装参数并保证工作目录存在。
#
# 为什么不把参数写进 unit:
#  1. 设备 SN 要动态取。vsync 自带的自动获取只认 getprop(Android)、
#     unifykeys(Amlogic)、getsn 三种,RK3566+Debian 一个都不匹配,
#     取不到就直接判配置校验失败退出,故必须由此处传 -m。
#  2. systemd 对不带引号的 ${VAR} 做 word splitting,空值会让整个参数消失,
#     导致后一个开关被当成前一个的值(nvr.service 踩过)。
#
# 工作目录必须由本脚本建:unit 的 WorkingDirectory 在 exec 前 chdir,
# 首启时 userdata 刚格式化、目录不存在会直接 200/CHDIR 崩溃循环。
# 此处 userdata 已挂载(unit 有 RequiresMountsFor),目录落在分区内。
#
# 为什么运行体要拷到 userdata:vsync 的自更新是**就地覆盖自己**——在
# os.Executable() 同目录写 <name>.new / <name>.backup 再替换本体
# (plugins/vsync/core/update_manager.go)。它没有 nvr-edge 那种双槽,
# 若直接跑 rootfs 里的基线,自更新会因 ProtectSystem=full 下 /usr 只读而失败。
# 故基线留在 rootfs 只读区兜底,运行体复制到可写的 work-dir,更新只动后者。
set -e

BASELINE=/usr/local/lib/vsync/vsync
WORK_DIR=${VSYNC_WORK_DIR:-/userdata/vsync}
BIN=$WORK_DIR/vsync

if [ -z "$VSYNC_DEVICE_SN" ] && [ -r /proc/device-tree/serial-number ]; then
	VSYNC_DEVICE_SN=$(tr -d '\0' < /proc/device-tree/serial-number)
fi
# SN 为空时 vsync 会判配置校验失败退出并被 Restart 无限重试,先把原因说清楚
if [ -z "$VSYNC_DEVICE_SN" ]; then
	echo "vsync: 取不到设备 SN(设备树 serial-number 不可读),请在 vsync.env 设 VSYNC_DEVICE_SN" >&2
fi
# 渠道号缺失不会让程序退出,而是静默回落 0 上报到错误渠道 —— 比 SN 缺失更隐蔽,
# 故显式告警。unit 的 EnvironmentFile 带 - 前缀,vsync.env 丢失时不会有任何提示。
if [ -z "$VSYNC_CHANNEL_ID" ]; then
	echo "vsync: 未配置渠道号 VSYNC_CHANNEL_ID,将回落 0;检查 /etc/nvr/vsync.env 是否存在" >&2
fi

# 注意:这里不能写成 `mkdir -p X && cd X`。set -e 对 && 列表中非末位的
# 失败命令有豁免,mkdir 失败时 cd 被跳过而脚本照常往下跑,最终带着错误的
# 工作目录 exec。分成两条才能让 set -e 真正拦住。
mkdir -p "$WORK_DIR"
cd "$WORK_DIR"

# 运行体缺失(首启、userdata 被格式化、或自更新写坏后被人工删除)时,
# 从出厂基线补一份。已存在则不动 —— 自更新的结果优先于基线,
# 与 nvr-edge 的"槽优先、基线兜底"同一原则。要强制回到出厂版本,删掉它重启即可。
# 判空不能只看 -x:0 字节文件同样满足 -x,而且执行它会被当成空脚本、
# 退出码 0,systemd 看着像正常退出,于是无限重启一个什么都不做的空程序。
# 自更新写到一半断电就可能留下这种残骸,故非空与可执行都要满足。
if [ ! -s "$BIN" ] || [ ! -x "$BIN" ]; then
	# 同样拆开写(见上):&& 串联会让 cp 的失败被 set -e 豁免,
	# 一路走到 exec 才报"文件不存在",掩盖真正的原因。
	# 先落 .tmp 再 mv,避免复制中途断电留下半个可执行文件。
	install -m 755 "$BASELINE" "$BIN.tmp"
	# 落盘后再改名:ext4 默认延迟分配,数据还在 page cache 时断电,
	# rename 过的文件会以长度 0 存活下来 —— 现场见过的 0 字节运行体正是这样来的
	sync "$BIN.tmp" 2>/dev/null || sync
	mv "$BIN.tmp" "$BIN"
fi

# 缓存(部署)目录用独立的 vcache 分区:同步下来的内容体积大且可再生,
# 与 10G 的 userdata 分开,写坏/写满都不影响配置与运行状态。
# 不显式传时程序会退到 <工作目录>/.cache,那会把 userdata 撑爆。
# 日志仍落 <工作目录>/logs,都不写只读 rootfs。
CACHE_DIR=${VSYNC_CACHE_DIR:-/vcache}
mkdir -p "$CACHE_DIR"

set -- -w "$WORK_DIR" -d "$CACHE_DIR" -m "$VSYNC_DEVICE_SN" \
	-log-level "${VSYNC_LOG_LEVEL:-error}" \
	-s "${VSYNC_CHANNEL_ID:-0}" \
	-customizer "${VSYNC_CUSTOMIZER:-umi}" \
	"$@"
[ -n "$VSYNC_DOMAIN" ] && set -- "$@" -domain "$VSYNC_DOMAIN"

exec "$BIN" "$@"
