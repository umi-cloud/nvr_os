#!/bin/bash
# 产测(工厂测试)。同一份固件走完全部工序,开机读厂商区阶段标记决定这次做什么:
#   空且未写 SN → pcba:单板自动测试,全过后等扫码枪(插主板)扫主板条码写 SN 与两个 MAC
#   pcba-pass    → aging:老化 AGING_MINUTES 分钟,必须一次开机内连续跑满;中途断电/重启则阶段
#                  不变,下次开机从零重来。跑满且无异常 → aging-pass
#   aging-pass   → finish:已组装,开机即自动收尾(清现场、阶段 → shipped)并重启进正常模式。
#                  用重启不用关机:组装工位若没上过电,第一次上电的就是用户,关机会让用户以为坏了
#   shipped      → 正常启动(nvr-edge/vsync)
#   空但已写 SN  → 产测上线前就写过号的开发板,按 shipped 处理
# 产测期间 getty@tty1、nvr、vsync 不启动(各自 drop-in 的 ConditionPathExists)。
# 结果显示在 tty1(HDMI)与工作灯上,明细落 /run/nvr-factory;也可经 ssh 调用,见 usage()。
# 运行时输出一律英文:tty1 的 fbcon 只有西文字形。
set -u
. /usr/local/lib/nvr-factory/common.sh

ITEMS=$FACTORY_LIB/items
ACTIVE=$FACTORY_RUN/active      # 产测模式标记,由 cmd_boot 创建
RESULTS=$FACTORY_RUN/results.jsonl
SUMMARY=$FACTORY_RUN/summary.json
SCREEN=$FACTORY_RUN/screen      # 屏幕列表数据源,每行 item|status|seconds|message
AG=$FACTORY_RUN/aging           # 老化各路负载的轮数、失败标记与最后一轮输出
AGING_RESULT=/userdata/.nvr-factory-aging.json   # /run 重启即清空,老化结论另存;finish 时删除
TTY=/dev/tty1
LED=/sys/class/leds/work-led

usage() {
	cat >&2 <<'EOF'
usage: nvr-factory <command>
  test [item...]                     run test items (default: all for this board), stage unchanged
  result                             latest results: JSON lines, then summary
  provision <SN> <MAC1> <MAC2>       write SN/MAC after a full PASS in this boot, stage -> pcba-pass
  finish [--no-poweroff|--reboot]    from aging-pass: clean up, stage -> shipped, then power off
  stage [set pcba|pcba-pass|aging-pass|shipped]   show or change stage (repair: set pcba)
  boot | auto                        called by systemd at boot
EOF
	exit 2
}

items_for() {
	case "$1" in
	# SATA 板没有 TF 卡槽(2026-10-20 确认)
	rk3566-nvr-sata) echo board ddr emmc eth usbeth sata usb3 rtc npu venc thermal watchdog hdmi ;;
	rk3566-nvr) echo board ddr emmc eth usb3 tf npu venc thermal watchdog hdmi ;;
	# RV1126B SATA 板:无 HDMI、无 TF;USB3 只有硬盘桥这一路(并入 sata 项),前面板 USB-A 是 USB2 → usb 项
	rv1126b-nvr-sata) echo board ddr emmc eth usbeth sata usb rtc npu venc thermal watchdog ;;
	esac
}

timeout_for() {
	case "$1" in
	ddr) echo 900 ;;
	*) echo 120 ;;
	esac
}

# ---------- 显示与工作灯:只在产测模式下动,出厂后 ssh 调 test 不能弄乱用户的屏幕和灯 ----------

in_factory() { [ -e "$ACTIVE" ]; }

# 工作灯:单板测试中快闪、老化中心跳闪、通过常亮、失败慢闪。板上只有这一颗灯能控制
# (另一颗是接 3.3V 的电源灯),老化架上没有显示器,只能靠闪法区分状态
led() {
	in_factory && [ -d $LED ] || return 0
	case "$1" in
	busy) echo timer > $LED/trigger; echo 100 > $LED/delay_on; echo 100 > $LED/delay_off ;;
	aging) echo heartbeat > $LED/trigger ;;
	pass) echo default-on > $LED/trigger ;;
	fail) echo timer > $LED/trigger; echo 1000 > $LED/delay_on; echo 1000 > $LED/delay_off ;;
	esac
} 2>/dev/null

scr() { in_factory && [ -w $TTY ] && printf "$@" > $TTY; return 0; }

# 让屏幕从 logo 切到控制台。fbcon 延迟接管(nvr.config)时只做普通提交,替换不掉 u-boot
# 交过来的 logo 图层,画面会一直停在 logo 上(2026-10-20 SATA 板实测)。把 tty1 切到图形模式
# 再切回文本模式,fbcon 会带 FB_ACTIVATE_KD_TEXT 强制提交(fbcon.c fbcon_blank 的 mode_switch 分支);
# getty@tty1 能切过去也是因为它把终端重置回文本模式。shell 没有发 KDSETMODE 的命令,
# 用 perl-base(Debian 必装)发 ioctl:0x4B3A = KDSETMODE,1 = KD_GRAPHICS,0 = KD_TEXT
fb_show() {
	local i v
	# 接管是异步的(fbcon_output_notifier 只 schedule_work),等 fbcon 绑定上再切,最多 3 秒
	for i in $(seq 30); do
		for v in /sys/class/vtconsole/vtcon*; do
			grep -q 'frame buffer' $v/name 2>/dev/null && [ "$(cat $v/bind)" = 1 ] && break 2
		done
		sleep 0.1
	done
	perl -e 'open(my $t, "+<", $ARGV[0]) or exit 1; ioctl($t, 0x4B3A, 1); ioctl($t, 0x4B3A, 0)' $TTY 2>/dev/null
	return 0
}

# 整屏重画:顶部三行彩色结论栏(41 红 42 绿 44 蓝),下面是 $SCREEN 列表,最后一行提示。
# 每行写满 cols-1 列:写满最后一列时 fbcon 会自动折行,再加换行就多出一个空行
draw() {
	local color=$1 banner=$2 footer=${3:-} cols w it st sec msg c
	in_factory || return 0
	cols=$(stty -F $TTY size 2>/dev/null | awk '{print $2}')
	w=$((${cols:-80} - 1))
	scr '\033[0;40;97m\033[2J\033[H'
	scr '\033[%s;97;1m%-*s\n%-*s\n%-*s\033[0;40;97m\n\n' "$color" $w "" $w "   $banner" $w ""
	[ -f "$SCREEN" ] && while IFS='|' read -r it st sec msg; do
		case "$st" in OK) c=32 ;; FAIL) c=31 ;; *) c=33 ;; esac
		scr '  \033[1;%sm%-4s\033[0;40;97m  %-9s %5s  %.*s\n' $c "$st" "$it" "$sec" $((w - 26)) "$msg"
	done < "$SCREEN"
	[ -n "$footer" ] && scr '\n  %s\n' "$footer"
	return 0
}

# ---------- 单板测试 ----------

# full:是否跑了本板全部测试项且没有跳过任何一项;写号只认 full 的 PASS
write_summary() {
	local result=$1 full=$2 failed=$3
	printf '{"board":"%s","stage":"%s","sn":"%s","result":"%s","full":%s,"failed":[%s],"time":"%s"}\n' \
		"$(board)" "$(json_esc "$(stage_get)")" "$(sn_get)" "$result" "$full" "$failed" \
		"$(date -Iseconds)" > "$SUMMARY"
}

# 记一项结果:JSON 给工装 PC,$SCREEN 给 tty1,stdout 给 ssh 上的人
record() {
	local it=$1 st=$2 sec=$3 msg=$4 extra=
	[ "$st" = SKIP ] && extra='"skip":true,'
	printf '{"item":"%s","pass":%s,%s"msg":"%s","sec":%d}\n' "$it" \
		"$([ "$st" = FAIL ] && echo false || echo true)" "$extra" "$(json_esc "$msg")" "$sec" >> "$RESULTS"
	printf '%s|%s|%ss|%s\n' "$it" "$st" "$sec" "$(printf '%s' "$msg" | tr -d '|')" >> "$SCREEN"
	printf '%-4s  %-9s %4ss  %s\n' "$st" "$it" "$sec" "$msg"
}

# 跑测试项并汇总;$@ 为空时跑本板全部。返回 0 = 全部通过
run_items() {
	local b list it out rc t0 to full=false failed= n=0 total fails=0
	b=$(board)
	list=${*:-$(items_for "$b")}
	[ -n "$list" ] || { echo "unknown board, no test items" >&2; return 1; }
	for it in $list; do
		[ -f "$ITEMS/$it" ] || { echo "unknown item: $it" >&2; return 2; }
	done
	[ $# = 0 ] && [ -z "$FACTORY_SKIP" ] && full=true
	total=$(echo $list | wc -w)
	mkdir -p $FACTORY_RUN
	: > "$RESULTS"
	: > "$SCREEN"
	write_summary RUNNING $full ""
	led busy
	for it in $list; do
		n=$((n + 1))
		case " $FACTORY_SKIP " in *" $it "*)
			record "$it" SKIP 0 "skipped by FACTORY_SKIP"
			continue ;;
		esac
		draw 44 "TESTING  $n/$total   board=$b" "running: $it ..."
		t0=$(date +%s)
		to=$(timeout_for "$it")
		out=$(timeout "$to" bash "$ITEMS/$it" 2>>"$FACTORY_RUN/$it.log")
		rc=$?
		[ $rc = 124 ] && out="timeout after ${to}s"
		out=$(printf '%s' "$out" | tail -1)
		if [ $rc = 0 ]; then
			record "$it" OK $(($(date +%s) - t0)) "$out"
		else
			fails=$((fails + 1))
			failed="$failed${failed:+,}\"$it\""
			record "$it" FAIL $(($(date +%s) - t0)) "$out"
		fi
	done
	if [ $fails = 0 ]; then
		write_summary PASS $full ""
		led pass
		draw 42 "PASS  $total/$total   board=$b" "waiting for provisioning (SN / MAC)"
		return 0
	fi
	write_summary FAIL $full "$failed"
	led fail
	draw 41 "FAIL  $fails/$total failed   board=$b" "send to repair; details: nvr-factory result"
	return 1
}

# ---------- 扫码写号 ----------

# 解析一次扫码,输出 "<SN 或 -> [MAC...]"(MAC 规范成小写冒号分隔);什么都没扫到或有对不上
# 的片段返回 1。SN 按本板前缀(sn_prefix,UMNVR3566/UMNVR1126)+7 位字母数字取;其余每段十六进制片段必须恰好是一个 MAC
# (12 位,或 6 组以 : / - 分隔)或两个连写的 MAC(24 位),否则整条拒绝 —— 宁可重扫,
# 不能写错号(例如 "MAC1:02AA.." 若宽松匹配会把 "C1" 吞进 MAC)
scan_fields() {
	local s sn=- t run hex macs= m
	s=$(printf '%s' "$1" | tr -d '\r')
	t=$(printf '%s' "$s" | grep -oE "$(sn_prefix)[0-9A-Za-z]{7}" | head -1)
	[ -n "$t" ] && { sn=$t; s=${s/$sn/ }; }
	for run in $(printf '%s' "$s" | grep -oE '[0-9A-Fa-f:-]+'); do
		hex=$(printf '%s' "$run" | tr -d ':-')
		[ -n "$hex" ] || continue
		if printf '%s' "$run" | grep -qxE '[0-9A-Fa-f]{12}|([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}|([0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}'; then
			macs="$macs $hex"
		elif printf '%s' "$run" | grep -qxE '[0-9A-Fa-f]{24}'; then
			macs="$macs ${hex:0:12} ${hex:12}"
		else
			return 1
		fi
	done
	[ "$sn" != - ] || [ -n "$macs" ] || return 1
	printf '%s' "$sn"
	for m in $macs; do printf ' %s' "$(printf '%s' "$m" | tr 'A-F' 'a-f' | sed 's/../&:/g; s/:$//')"; done
	echo
}

# 单板测试全过后等扫码枪(USB 键盘)扫主板条码并写号。扫码内容从 tty1 读入、不回显。
# 两种标签都支持:一个码含 SN+两个 MAC 扫一次即可;分开的码按 SN → MAC1(千兆)→ MAC2(USB)
# 顺序扫,屏幕逐步提示并显示已收到的内容。MAC 按扫入先后定 MAC1/MAC2,扫到 SN 即从头开始
# (扫错顺序时重扫 SN)。必须先有 SN 再收 MAC,避免上一块板残留的扫码混进来。
# tty1 在整个循环里保持打开(fd 3):每次 read 都重新打开的话,两次之间连扫的字符可能丢
scan_provision() {
	local banner=$1 line f fsn m sn= m1= m2= next note=
	stty -F $TTY -echo icanon 2>/dev/null
	exec 3< $TTY
	while :; do
		if [ -z "$sn" ]; then next="SN"
		elif [ -z "$m1" ]; then next="MAC1 (gigabit port)"
		else next="MAC2 (USB port)"; fi
		draw 42 "$banner" "SCAN BARCODE   next: $next"
		scr '  SN:   %s\n  MAC1: %s\n  MAC2: %s\n' "${sn:--}" "${m1:--}" "${m2:--}"
		[ -n "$note" ] && scr '\n  \033[1;33m%s\033[0;40;97m\n' "$note"
		note=
		IFS= read -r line <&3 || { sleep 1; continue; }
		[ -n "$line" ] || continue
		echo "scanned: $line"
		if ! f=$(scan_fields "$line"); then
			note="BAD BARCODE: $(printf '%s' "$line" | tr -cd '[:print:]' | cut -c1-60) - scan again"
			continue
		fi
		set -- $f
		fsn=$1
		shift
		if [ "$fsn" != - ]; then
			sn=$fsn; m1=; m2=
		elif [ -z "$sn" ]; then
			note="scan SN first"
			continue
		fi
		for m; do
			if [ -z "$m1" ]; then m1=$m
			elif [ -z "$m2" ]; then m2=$m
			else note="too many MACs - scan SN to start over"; m1=; m2=; break; fi
		done
		[ -n "$sn" ] && [ -n "$m1" ] && [ -n "$m2" ] || continue
		if cmd_provision "$sn" "$m1" "$m2"; then
			exec 3<&-
			return 0
		fi
		note="PROVISION FAILED (see journal) - scan SN to start over"
		sn=; m1=; m2=
	done
}

# ---------- 老化 ----------
# CPU+内存(3 路 memtester)、NPU(npu-check)、硬件编码(mpi_enc_test)各自循环满载
# AGING_MINUTES 分钟,每 10 秒巡检一次:任一路负载报错、温度超 AGING_THERMAL_MAX_C 即判失败。
# 计时只在本次开机内有效:中途断电/重启时阶段仍是 pcba-pass,下次开机从零重来(产线要求)。
# 留一个核给系统与巡检;卡死由 PID 1 喂的硬件看门狗复位,复位后同样从零重来

# 一路负载:$1=名称,其余为单轮命令;循环执行,首次失败写 $AG/<名称>.fail 后退出。
# 每轮覆盖写 $AG/<名称>.last:memtester 进度输出很大,累积下来会占几十 MB 内存(/run 是 tmpfs)
aging_load() {
	local name=$1 n=0
	shift
	while :; do
		if ! "$@" > "$AG/$name.last" 2>&1; then
			echo "round $((n + 1)) failed" > "$AG/$name.fail"
			return 1
		fi
		n=$((n + 1))
		echo $n > "$AG/$name.rounds"
	done
}

aging_run() {
	local dur=$((AGING_MINUTES * 60)) t0 el=0 temp max=0 fail= pids= p sn i clock
	local h264=/tmp/nvr-factory-aging.h264
	sn=$(sn_get)
	rm -rf $AG
	mkdir -p $AG
	SCREEN=$AG/screen
	led aging
	for i in 1 2 3; do
		aging_load ddr$i memtester 256M 1 &
		pids="$pids $!"
	done
	aging_load npu "$NPU_BIN" "$NPU_MODEL" 50 &
	pids="$pids $!"
	# mpp 默认逐帧写 syslog,120 分钟老化会把 64M 的 journal 冲满(2026-10-20 实测 58.7M,老化结论
	# 那几行也被挤掉);mpi_enc_test 的 -v q 管不到 mpp 库自己的日志,要用 mpp_log_level=2(只留错误)
	aging_load venc env mpp_log_level=2 mpi_enc_test -w 1920 -h 1080 -t 7 -n 300 -o $h264 &
	pids="$pids $!"
	t0=$(cut -d. -f1 /proc/uptime)
	while :; do
		el=$(($(cut -d. -f1 /proc/uptime) - t0))
		temp=$(max_temp_c)
		[ "$temp" -gt $max ] && max=$temp
		[ "$temp" -lt "$AGING_THERMAL_MAX_C" ] || fail="thermal ${temp}C >= ${AGING_THERMAL_MAX_C}C"
		: > $SCREEN
		for i in ddr1 ddr2 ddr3 npu venc; do
			if [ -f $AG/$i.fail ]; then
				fail=${fail:-"$i $(cat $AG/$i.fail)"}
				echo "$i|FAIL||$(cat $AG/$i.fail)" >> $SCREEN
			else
				echo "$i|RUN||$(cat $AG/$i.rounds 2>/dev/null || echo 0) rounds" >> $SCREEN
			fi
		done
		echo "thermal|$([ "$temp" -lt "$AGING_THERMAL_MAX_C" ] && echo OK || echo FAIL)||now ${temp}C, max ${max}C, limit ${AGING_THERMAL_MAX_C}C" >> $SCREEN
		[ -n "$fail" ] || [ $el -ge $dur ] && break
		draw 44 "AGING  $(printf '%02d:%02d / %02d:00' $((el / 60)) $((el % 60)) $AGING_MINUTES)   SN=$sn" \
			"do not power off - aging restarts from zero after power loss"
		sleep 10
	done
	# 只停自己起的负载:先停循环,再停它们手上正在跑的那一轮
	for p in $pids; do
		kill $p 2>/dev/null
		pkill -P $p 2>/dev/null
	done
	wait 2>/dev/null
	rm -f $h264
	clock=$(printf '%02d:%02d' $((el / 60)) $((el % 60)))
	if [ -n "$fail" ]; then
		printf '{"aging":"FAIL","reason":"%s","seconds":%d,"max_temp":%d}\n' "$(json_esc "$fail")" $el $max > $FACTORY_RUN/aging.json
		led fail
		draw 41 "AGING FAIL  $clock   SN=$sn" "$fail - send to repair"
		echo "aging FAIL after ${el}s: $fail"
		return 1
	fi
	printf '{"aging":"PASS","seconds":%d,"max_temp":%d,"time":"%s"}\n' $el $max "$(date -Iseconds)" > $FACTORY_RUN/aging.json
	cp $FACTORY_RUN/aging.json $AGING_RESULT
	stage_set aging-pass || { led fail; draw 41 "AGING DONE but stage write failed" "send to repair"; return 1; }
	led pass
	draw 42 "AGING PASS  ${AGING_MINUTES} min   SN=$sn" "power off and move to assembly"
	echo "aging PASS ${el}s, max ${max}C, stage -> aging-pass"
	# journald 默认 5 分钟才落盘,老化完常被直接断电,结论这几行要立即写下去
	journalctl --sync 2>/dev/null
}

# ---------- 命令 ----------

cmd_boot() {
	local st mode
	mkdir -p $FACTORY_RUN
	rm -f $ACTIVE
	st=$(stage_get)
	if [ -z "$(board)" ]; then
		mode=normal # rootfs 多芯片共用,未适配产测的板型直接正常启动
	else
		case "$st" in
		shipped) mode=normal ;;
		pcba-pass) mode=aging ;;
		aging-pass) mode=finish ;;
		pcba) mode=pcba ;;
		"") [ -n "$(sn_get)" ] && mode=normal || mode=pcba ;;
		*) mode=unknown ;; # 不认识的标记一律不放行到正常启动
		esac
	fi
	echo "$mode" > $FACTORY_RUN/mode
	[ "$mode" = normal ] || touch $ACTIVE
	echo "stage=${st:-<empty>} mode=$mode"
}

cmd_auto() {
	local n
	TERM=linux setterm --blank 0 --powerdown 0 --cursor off > $TTY 2>/dev/null
	# 上一行向 tty1 输出,fbcon 随之接管,接管之后才能切画面
	fb_show
	case "$(cat $FACTORY_RUN/mode 2>/dev/null)" in
	pcba)
		n=$(items_for "$(board)" | wc -w)
		run_items && scan_provision "PASS  $n/$n   board=$(board)"
		;;
	aging)
		aging_run
		;;
	finish)
		# 组装后上电:不快检、不扫码,直接收尾(2026-10-21 产线定)
		led pass
		: > "$SCREEN"
		draw 42 "FINISHING   SN=$(sn_get)" \
			"factory flow complete - rebooting into normal mode   $(tr -d '{}"' < $AGING_RESULT 2>/dev/null | tr ',' ' ')"
		sleep 3
		cmd_finish --reboot || { led fail; draw 41 "FINISH FAILED   SN=$(sn_get)" "see journal - send to repair"; }
		;;
	*)
		led fail
		draw 41 "UNKNOWN FACTORY STAGE: $(stage_get)" "fix with: nvr-factory stage set pcba|pcba-pass|aging-pass|shipped"
		;;
	esac
	return 0 # 测试失败也算服务正常结束,结论在 summary.json
}

cmd_provision() {
	[ $# = 3 ] || { echo "usage: nvr-factory provision <SN> <MAC1> <MAC2>" >&2; return 2; }
	[ "$(cat $FACTORY_RUN/mode 2>/dev/null)" = pcba ] || { echo "not in PCBA test stage" >&2; return 1; }
	grep -q '"result":"PASS"' "$SUMMARY" 2>/dev/null && grep -q '"full":true' "$SUMMARY" ||
		{ echo "no full PASS in this boot (all items, none skipped); refusing to provision" >&2; return 1; }
	/usr/local/sbin/nvr-provision "$@" || return 1
	stage_set pcba-pass || return 1
	draw 42 "PASS   SN=$1" "provisioned - power off and move to aging"
	echo "provisioned, stage -> pcba-pass"
}

cmd_finish() {
	local st
	st=$(stage_get)
	[ "$st" = aging-pass ] || { echo "stage is ${st:-<empty>}, finish requires aging-pass" >&2; return 1; }
	# 清现场:先清后改阶段,中途断电重跑 finish 即可;反过来会带着测试残留出厂
	rm -f /userdata/.nvr-factory-* /root/.bash_history
	journalctl --rotate >/dev/null 2>&1
	journalctl --vacuum-time=1s >/dev/null 2>&1
	# 每台设备唯一的身份,下次开机重新生成(与镜像构建期的处理一致,见 mk-rootfs-bookworm.sh)
	: > /etc/machine-id
	rm -f /etc/ssh/ssh_host_*
	stage_set shipped || return 1
	sync
	echo "finished, stage -> shipped"
	journalctl --sync 2>/dev/null
	case "${1:-}" in
	--no-poweroff) ;;
	--reboot) systemctl reboot ;;
	*) systemctl poweroff ;;
	esac
}

cmd_stage() {
	local st
	[ $# = 0 ] && { st=$(stage_get); echo "${st:-<empty>}"; return 0; }
	[ "$1" = set ] && [ $# = 2 ] || usage
	case "$2" in pcba | pcba-pass | aging-pass | shipped) ;; *) echo "invalid stage: $2" >&2; return 2 ;; esac
	stage_set "$2" && echo "stage -> $2 (takes effect after reboot)"
}

case "${1:-}" in
boot) cmd_boot ;;
auto) cmd_auto ;;
test) shift; run_items "$@" ;;
result) cat "$RESULTS" "$SUMMARY" 2>/dev/null ;;
provision) shift; cmd_provision "$@" ;;
finish) shift; cmd_finish "$@" ;;
stage) shift; cmd_stage "$@" ;;
*) usage ;;
esac
