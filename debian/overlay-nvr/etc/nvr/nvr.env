# nvr-edge 运行参数(镜像内默认值)
# 设备身份由产线/现场写入 /userdata/nvr/nvr.env 覆盖本文件,rootfs 只读后仍可改。
# 目录约定见 docs/nvr-edge-integration.md。
#
# 本文件由 systemd EnvironmentFile 解析,只认 KEY=VALUE 字面值、不执行 shell:
# 写 NVR_DEVICE_SN=cat /proc/device-tree/serial-number 只会得到那串文本本身,
# 设备会带着它去连云平台。要动态取值,逻辑写在引导器 /usr/local/bin/nvr 里。

# work-dir:config/(DB、model_cache)与 data/(models、selfupdate、offlineq)的根
NVR_WORK_DIR=/userdata/nvr

# cache-dir:仅决定无盘时的录像根(<cache-dir>/media/nvr);
# 录像段暂存目录不受此项控制,由 nvr-edge 按有无 /media/nvr 挂载自行选择
NVR_CACHE_DIR=/userdata/nvr/cache

# 云平台 MQTT topic 路由的 channel ID;留空则启动后停在待绑定态。
# 每台设备不同时,由 /userdata/nvr/nvr.env 覆盖这里的默认值。
NVR_AGENT_ID=102

# 设备序列号:**保持留空**。引导器会动态读 /proc/device-tree/serial-number
# (硬件唯一、免产线逐台写入)。仅在需要覆盖硬件序列号时才填。
NVR_DEVICE_SN=
