/dts-v1/;

/ {
	compatible = "rockchip,rv1126b-evb1-v10\0rockchip,rv1126b";
	interrupt-parent = <0x01>;
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = "Rockchip RV1126B EVB1 V10 Board";

	aliases {
		csi2dphy0 = "/csi2-dphy0";
		csi2dphy1 = "/csi2-dphy1";
		csi2dphy2 = "/csi2-dphy2";
		csi2dphy3 = "/csi2-dphy3";
		csi2dphy4 = "/csi2-dphy4";
		csi2dphy5 = "/csi2-dphy5";
		ethernet0 = "/ethernet@21c70000";
		gpio0 = "/pinctrl/gpio@20600000";
		gpio1 = "/pinctrl/gpio@21300000";
		gpio2 = "/pinctrl/gpio@21700000";
		gpio3 = "/pinctrl/gpio@21e00000";
		gpio4 = "/pinctrl/gpio@21800000";
		gpio5 = "/pinctrl/gpio@21900000";
		gpio6 = "/pinctrl/gpio@21a00000";
		gpio7 = "/pinctrl/gpio@21b00000";
		i2c0 = "/i2c@21100000";
		i2c1 = "/i2c@21110000";
		i2c2 = "/i2c@20800000";
		i2c3 = "/i2c@21120000";
		i2c4 = "/i2c@21130000";
		i2c5 = "/i2c@21140000";
		mmc0 = "/mmc@21470000";
		mmc1 = "/mmc@21d60000";
		mmc2 = "/mmc@21f60000";
		rkcif_mipi_lvds0 = "/rkcif-mipi-lvds";
		rkcif_mipi_lvds1 = "/rkcif-mipi-lvds1";
		rkcif_mipi_lvds2 = "/rkcif-mipi-lvds2";
		rkcif_mipi_lvds3 = "/rkcif-mipi-lvds3";
		serial0 = "/serial@20810000";
		serial1 = "/serial@21160000";
		serial2 = "/serial@21170000";
		serial3 = "/serial@21180000";
		serial4 = "/serial@21190000";
		serial5 = "/serial@211a0000";
		serial6 = "/serial@211b0000";
		serial7 = "/serial@211c0000";
		spi0 = "/spi@211e0000";
		spi1 = "/spi@211f0000";
		spi2 = "/spi@21460000";
		spi3 = "/spi@208c0000";
	};

	clocks {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		sai0-fs {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			clock-output-names = "fs_inter_from_sai0";
			status = "disabled";
			phandle = <0x110>;
		};

		sai1-fs {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			clock-output-names = "fs_inter_from_sai1";
			status = "disabled";
			phandle = <0x111>;
		};

		sai2-fs {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			clock-output-names = "fs_inter_from_sai2";
			status = "disabled";
			phandle = <0x112>;
		};

		sai0-mclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			clock-output-names = "mclk_sai0_from_io";
			status = "disabled";
			phandle = <0x113>;
		};

		sai1-mclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			clock-output-names = "mclk_sai1_from_io";
			status = "disabled";
			phandle = <0x114>;
		};

		sai2-mclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			clock-output-names = "mclk_sai2_from_io";
			status = "disabled";
			phandle = <0x115>;
		};

		sai0-sclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			clock-output-names = "sclk_sai0_from_io";
			status = "disabled";
			phandle = <0x116>;
		};

		sai1-sclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			clock-output-names = "sclk_sai1_from_io";
			status = "disabled";
			phandle = <0x117>;
		};

		sai2-sclkin {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			clock-output-names = "sclk_sai2_from_io";
			status = "disabled";
			phandle = <0x118>;
		};

		xin32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			clock-output-names = "xin32k";
			phandle = <0x119>;
		};

		xin24m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x16e3600>;
			clock-output-names = "xin24m";
			phandle = <0xea>;
		};

		clk_rcosc {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x5b8d800>;
			clock-output-names = "clk_rcosc";
			phandle = <0x11a>;
		};

		sai0-mclkout@20100048 {
			compatible = "rockchip,clk-out";
			reg = <0x20100048 0x04>;
			clocks = <0x02 0x73>;
			#clock-cells = <0x00>;
			clock-output-names = "mclk_sai0_to_io";
			rockchip,bit-shift = <0x00>;
			rockchip,bit-set-to-disable;
			status = "disabled";
			phandle = <0x11b>;
		};

		sai1-mclkout@20100048 {
			compatible = "rockchip,clk-out";
			reg = <0x20100048 0x04>;
			clocks = <0x02 0x74>;
			#clock-cells = <0x00>;
			clock-output-names = "mclk_sai1_to_io";
			rockchip,bit-shift = <0x01>;
			rockchip,bit-set-to-disable;
			status = "disabled";
			phandle = <0x11c>;
		};

		sai2-mclkout@20100048 {
			compatible = "rockchip,clk-out";
			reg = <0x20100048 0x04>;
			clocks = <0x02 0x75>;
			#clock-cells = <0x00>;
			clock-output-names = "mclk_sai2_to_io";
			rockchip,bit-shift = <0x02>;
			rockchip,bit-set-to-disable;
			status = "disabled";
			phandle = <0x11d>;
		};

		pvtpll-core@20480000 {
			compatible = "rockchip,rv1126b-core-pvtpll\0syscon";
			reg = <0x20480000 0x100>;
			clocks = <0x02 0x04>;
			#clock-cells = <0x00>;
			clock-output-names = "clk_core_pvtpll";
			assigned-clocks = <0x03>;
			assigned-clock-rates = <0x47868c00>;
			phandle = <0x03>;
		};

		pvtpll-isp@21c60000 {
			compatible = "rockchip,rv1126b-isp-pvtpll";
			reg = <0x21c60000 0x100>;
			rockchip,cru = <0x02>;
			#clock-cells = <0x00>;
			clock-output-names = "clk_isp_pvtpll";
			assigned-clocks = <0x04>;
			assigned-clock-rates = <0x1d34ce80>;
			phandle = <0x04>;
		};

		pvtpll-enc@21f00000 {
			compatible = "rockchip,rv1126b-enc-pvtpll";
			reg = <0x21f00000 0x100>;
			#clock-cells = <0x00>;
			clock-output-names = "clk_vepu_pvtpll";
			assigned-clocks = <0x05>;
			assigned-clock-rates = <0x1c9c3800>;
			phandle = <0x05>;
		};

		pvtpll-aisp@21fc0000 {
			compatible = "rockchip,rv1126b-aisp-pvtpll";
			reg = <0x21fc0000 0x100>;
			rockchip,cru = <0x02>;
			#clock-cells = <0x00>;
			clock-output-names = "clk_vcp_pvtpll";
			assigned-clocks = <0x06>;
			assigned-clock-rates = <0x2e318fc0>;
			phandle = <0x06>;
		};

		pvtpll-npu@22080000 {
			compatible = "rockchip,rv1126b-npu-pvtpll\0syscon";
			reg = <0x22080000 0x100>;
			rockchip,cru = <0x02>;
			clocks = <0x02 0x7f>;
			#clock-cells = <0x00>;
			clock-output-names = "clk_npu_pvtpll";
			assigned-clocks = <0x07>;
			assigned-clock-rates = <0x2faf0800>;
			phandle = <0x07>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			enable-method = "psci";
			clocks = <0x02 0x04>;
			operating-points-v2 = <0x08>;
			cpu-idle-states = <0x09>;
			cpu-supply = <0x0a>;
			phandle = <0x26>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			enable-method = "psci";
			clocks = <0x02 0x04>;
			operating-points-v2 = <0x08>;
			cpu-idle-states = <0x09>;
			phandle = <0x27>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			enable-method = "psci";
			clocks = <0x02 0x04>;
			operating-points-v2 = <0x08>;
			cpu-idle-states = <0x09>;
			phandle = <0x28>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			enable-method = "psci";
			clocks = <0x02 0x04>;
			operating-points-v2 = <0x08>;
			cpu-idle-states = <0x09>;
			phandle = <0x29>;
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x78>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x384>;
				phandle = <0x09>;
			};
		};
	};

	cpu0-opp-table {
		compatible = "operating-points-v2";
		opp-shared;
		nvmem-cells = <0x0b>;
		nvmem-cell-names = "leakage";
		rockchip,pvtm-voltage-sel = <0x00 0x685 0x00 0x686 0x6b2 0x01 0x6b3 0x6df 0x02 0x6e0 0x70c 0x03 0x70d 0x739 0x04 0x73a 0x766 0x05 0x767 0x793 0x06 0x794 0x7c0 0x07 0x7c1 0x7ed 0x08>;
		rockchip,pvtm-pvtpll;
		rockchip,pvtm-offset = <0x54>;
		rockchip,pvtm-sample-time = <0x1f4>;
		rockchip,pvtm-freq = <0x188940>;
		rockchip,pvtm-volt = <0x10c8e0>;
		rockchip,pvtm-ref-temp = <0x28>;
		rockchip,pvtm-temp-prop = <0x00 0x00>;
		rockchip,pvtm-thermal-zone = "cpu-thermal";
		rockchip,grf = <0x03>;
		rockchip,temp-hysteresis = <0x1388>;
		rockchip,low-temp = <0x2710>;
		rockchip,low-temp-min-volt = <0xe7ef0>;
		phandle = <0x08>;

		opp-594000000 {
			opp-hz = <0x00 0x2367b880>;
			opp-microvolt = <0xcf850 0xcf850 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
			opp-suspend;
		};

		opp-816000000 {
			opp-hz = <0x00 0x30a32c00>;
			opp-microvolt = <0xcf850 0xcf850 0x10c8e0>;
			opp-microvolt-L0 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-L1 = <0xd59f8 0xd59f8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1008000000 {
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt = <0xcf850 0xcf850 0x10c8e0>;
			opp-microvolt-L0 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-L1 = <0xd59f8 0xd59f8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-L0 = <0xe7ef0 0xe7ef0 0x10c8e0>;
			opp-microvolt-L1 = <0xe1d48 0xe1d48 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1296000000 {
			opp-hz = <0x00 0x4d3f6400>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x10c8e0>;
			opp-microvolt-L0 = <0xf4240 0xf4240 0x10c8e0>;
			opp-microvolt-L1 = <0xee098 0xee098 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1416000000 {
			opp-hz = <0x00 0x54667200>;
			opp-microvolt = <0xee098 0xee098 0x10c8e0>;
			opp-microvolt-L0 = <0xfa3e8 0xfa3e8 0x10c8e0>;
			opp-microvolt-L1 = <0xf4240 0xf4240 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1512000000 {
			opp-hz = <0x00 0x5a1f4a00>;
			opp-microvolt = <0xf4240 0xf4240 0x10c8e0>;
			opp-microvolt-L0 = <0x100590 0x100590 0x10c8e0>;
			opp-microvolt-L1 = <0xfa3e8 0xfa3e8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1608000000 {
			opp-hz = <0x00 0x5fd82200>;
			opp-microvolt = <0xf4240 0xf4240 0x10c8e0>;
			opp-microvolt-L0 = <0x10c8e0 0x10c8e0 0x10c8e0>;
			opp-microvolt-L1 = <0x106738 0x106738 0x10c8e0>;
			opp-microvolt-L2 = <0x100590 0x100590 0x10c8e0>;
			opp-microvolt-L3 = <0xfa3e8 0xfa3e8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
	};

	cpuinfo {
		compatible = "rockchip,cpuinfo";
		nvmem-cells = <0x0c 0x0d 0x0e>;
		nvmem-cell-names = "id\0cpu-version\0cpu-code";
	};

	csi2-dphy0 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x0f 0x10>;
		status = "okay";
		phandle = <0x11e>;

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				endpoint@1 {
					reg = <0x01>;
					remote-endpoint = <0x11>;
					data-lanes = <0x01 0x02>;
					phandle = <0x96>;
				};

				endpoint@2 {
					reg = <0x02>;
					remote-endpoint = <0x12>;
					data-lanes = <0x01 0x02 0x03 0x04>;
					phandle = <0x94>;
				};

				endpoint@3 {
					reg = <0x03>;
					remote-endpoint = <0x13>;
					data-lanes = <0x01 0x02 0x03 0x04>;
					phandle = <0x97>;
				};

				endpoint@4 {
					reg = <0x04>;
					remote-endpoint = <0x14>;
					data-lanes = <0x01 0x02 0x03 0x04>;
					phandle = <0x9a>;
				};

				endpoint@5 {
					reg = <0x05>;
					remote-endpoint = <0x15>;
					data-lanes = <0x04>;
					phandle = <0x93>;
				};

				endpoint@6 {
					reg = <0x06>;
					remote-endpoint = <0x16>;
					data-lanes = <0x01 0x02 0x03 0x04>;
					phandle = <0x99>;
				};

				endpoint@7 {
					reg = <0x07>;
					remote-endpoint = <0x17>;
					data-lanes = <0x01 0x02 0x03 0x04>;
					phandle = <0x98>;
				};

				endpoint@8 {
					reg = <0x08>;
					remote-endpoint = <0x18>;
					data-lanes = <0x01 0x02 0x03 0x04>;
					phandle = <0x95>;
				};
			};

			port@1 {
				reg = <0x01>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				endpoint@0 {
					reg = <0x00>;
					remote-endpoint = <0x19>;
					phandle = <0x24>;
				};
			};
		};
	};

	csi2-dphy1 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x0f 0x10>;
		status = "disabled";
		phandle = <0x11f>;
	};

	csi2-dphy2 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x0f 0x10>;
		status = "disabled";
		phandle = <0x120>;
	};

	csi2-dphy3 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x0f 0x10>;
		status = "disabled";
		phandle = <0x121>;
	};

	csi2-dphy4 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x0f 0x10>;
		status = "disabled";
		phandle = <0x122>;
	};

	csi2-dphy5 {
		compatible = "rockchip,rv1126b-csi2-dphy";
		rockchip,hw = <0x0f 0x10>;
		status = "disabled";
		phandle = <0x123>;
	};

	display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <0x1a>;
		status = "okay";
		logo-memory-region = <0x1b>;
		phandle = <0x124>;

		route {

			route-dsi {
				status = "okay";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <0x1c>;
				phandle = <0x125>;
			};

			route-rgb {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <0x1d>;
				phandle = <0x126>;
			};
		};
	};

	dmc {
		compatible = "rockchip,rv1126b-dmc";
		interrupts = <0x00 0x79 0x04>;
		interrupt-names = "complete";
		devfreq-events = <0x1e>;
		clocks = <0x02 0x05>;
		clock-names = "dmc_clk";
		operating-points-v2 = <0x1f>;
		upthreshold = <0x28>;
		downdifferential = <0x14>;
		system-status-level = <0x01 0x04 0x08 0x08 0x02 0x01 0x10 0x04 0x10000 0x04 0x1000 0x08 0x4000 0x08 0x2000 0x08 0xc00 0x08>;
		auto-min-freq = <0x4f1a0>;
		auto-freq-en = <0x01>;
		status = "disabled";
		phandle = <0x127>;
	};

	dmc-opp-table {
		compatible = "operating-points-v2";
		rockchip,temp-hysteresis = <0x1388>;
		rockchip,low-temp = <0x2710>;
		rockchip,low-temp-min-volt = <0xe7ef0>;
		phandle = <0x1f>;

		opp-1560000000 {
			opp-hz = <0x00 0x5cfbb600>;
			opp-microvolt = <0xdbba0 0xdbba0 0xe7ef0>;
		};
	};

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x00>;
		rockchip,wake-irq = <0x00>;
		rockchip,irq-mode-enable = <0x01>;
		rockchip,baudrate = <0x16e360>;
		interrupts = <0x00 0xf0 0x04>;
		status = "okay";
		phandle = <0x128>;
	};

	firmware {

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
			status = "disabled";
			phandle = <0x129>;
		};
	};

	mipi0-csi2 {
		compatible = "rockchip,rv1126b-mipi-csi2";
		rockchip,hw = <0x20 0x21 0x22 0x23>;
		status = "okay";
		phandle = <0x12a>;

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				endpoint@1 {
					reg = <0x01>;
					remote-endpoint = <0x24>;
					phandle = <0x19>;
				};
			};

			port@1 {
				reg = <0x01>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				endpoint@0 {
					reg = <0x00>;
					remote-endpoint = <0x25>;
					phandle = <0x2d>;
				};
			};
		};
	};

	mipi1-csi2 {
		compatible = "rockchip,rv1126b-mipi-csi2";
		rockchip,hw = <0x20 0x21 0x22 0x23>;
		status = "disabled";
		phandle = <0x12b>;
	};

