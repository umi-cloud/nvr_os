	dummy-codec {
		status = "okay";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0x00>;
		phandle = <0x105>;
	};

	pdm-mic-array {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,pdm-mic-array";
		phandle = <0x36f>;

		simple-audio-card,cpu {
			sound-dai = <0x104>;
		};

		simple-audio-card,codec {
			sound-dai = <0x105>;
		};
	};

	vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0xb71b00>;
		regulator-max-microvolt = <0xb71b00>;
		phandle = <0x8c>;
	};

	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <0x106>;
		reset-gpios = <0x6f 0x0a 0x01>;
		phandle = <0xe1>;
	};

	vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x8c>;
		status = "okay";
		phandle = <0x8d>;
	};

	vbus5v0-typec {
		compatible = "regulator-fixed";
		regulator-name = "vbus5v0_typec";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		enable-active-high;
		gpio = <0x107 0x1e 0x00>;
		vin-supply = <0x8d>;
		pinctrl-names = "default";
		pinctrl-0 = <0x108>;
		phandle = <0xbf>;
	};

	vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		enable-active-high;
		gpio = <0x107 0x07 0x00>;
		vin-supply = <0x8d>;
		pinctrl-names = "default";
		pinctrl-0 = <0x109>;
		phandle = <0xbe>;
	};

	vcc-mipi {
		compatible = "regulator-fixed";
		regulator-name = "vcc_mipi";
		gpio = <0x9e 0x02 0x00>;
		enable-active-high;
		regulator-boot-on;
		phandle = <0x9d>;
	};

	vcc-sd {
		compatible = "regulator-fixed";
		gpio = <0x6f 0x08 0x01>;
		regulator-name = "vcc_sd";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		enable-active-low;
		regulator-boot-on;
		vin-supply = <0x8c>;
		phandle = <0xd7>;
	};

	vccio-sd {
		compatible = "regulator-gpio";
		regulator-boot-on;
		regulator-name = "vccio_sd";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x325aa0>;
		pinctrl-names = "default";
		pinctrl-0 = <0x10a>;
		gpios = <0x6f 0x06 0x00>;
		vin-supply = <0x8d>;
		states = <0x1b7740 0x00 0x325aa0 0x01>;
		phandle = <0xd8>;
	};

	vdd-npu {
		compatible = "pwm-regulator";
		pwms = <0x10b 0x00 0x61a8 0x01>;
		regulator-name = "vdd_npu";
		regulator-init-microvolt = <0xe7ef0>;
		regulator-min-microvolt = <0xb71b0>;
		regulator-max-microvolt = <0x10c8e0>;
		regulator-always-on;
		regulator-boot-on;
		enable-gpios = <0x6f 0x03 0x00>;
		pwm-supply = <0x8d>;
		phandle = <0xe7>;
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <0x10c 0x06 0x01>;
		pinctrl-names = "default\0rts_gpio";
		pinctrl-0 = <0x10d>;
		pinctrl-1 = <0x10e>;
		BT,power_gpio = <0x6f 0x00 0x00>;
		status = "okay";
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <0x56>;
		pinctrl-names = "default";
		pinctrl-0 = <0x10f>;
		wifi_chip_type = "rk96x";
		WIFI,host_wake_irq = <0x6f 0x09 0x00>;
		status = "okay";
	};

