/*
 * Luckfox Aura (RV1126B) 开发板
 *
 * 用途:验证 RV1126B 软件栈,不是出货版型。
 * 依据:Luckfox 公开的原理图(外设页),SoC 与电源页官方未公开,故电源树按固定电压写。
 * 本文件不 include EVB dtsi:EVB 带 RK801 PMIC 与摄像头/显示外设,本板没有。
 *
 * 已开:串口/eMMC/SD/网口/USB,及 SoC 内部的 NPU/MPP 编解码/JPEG/RGA/温控;
 * 未配:WiFi(SDMMC1)、音频、MIPI CSI/DSI、PoE,CPU/NPU 调频(缺电源页,不知调压方式)。
 * 板载 eMMC 64GB(官网规格,画在未公开的 SoC 页上)为系统盘,MicroSD 为扩展;无 SATA、无 USB3。
 */

/dts-v1/;

#include "rv1126b.dtsi"

/ {
	model = "Luckfox Aura RV1126B Board";
	compatible = "luckfox,aura", "rockchip,rv1126b";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x20810000 console=ttyFIQ0 rw root=PARTUUID=614e0000-0000 rootfstype=ext4 rootwait coherent_pool=32K";
	};

	vcc_3v3: vcc-3v3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vcc_1v8: vcc-1v8-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/* SDMMC0_PWREN_H(GPIO0_B2)经 PMOS 给卡槽供 VCC_SD_S0 */
	vcc_sd: vcc-sd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sd";
		gpio = <&gpio0 RK_PB2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3>;
	};

	/* USB2_PWR(GPIO0_C4)使能 DIO7003 负载开关,给 CH334F hub 的下游口供 5V */
	vcc5v0_host: vcc5v0-host-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		gpio = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};
};

/* CH334F hub 复位(GPIO0_C5),拉高解复位。极性待实测确认 */
&gpio0 {
	usb_hub_rst_hog {
		gpio-hog;
		gpios = <RK_PC5 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb_hub_rst";
	};
};

/* 照搬官方 EVB1 V10;eMMC 所在页未公开,IO 电压未知,HS200 调谐失败时先去掉 mmc-hs200-1_8v */
&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	non-removable;
	mmc-hs200-1_8v;
	rockchip,default-sample-phase = <90>;
	no-sdio;
	no-sd;
	status = "okay";
};

&fiq_debugger {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m2_xfer_pins>;
	status = "okay";
};

/* 调试口在 GPIO0_B3/B4(uart0 的 m2 组);SoC 默认的 m0 组在 GPIO2_A0/A1,与 SD 卡冲突 */
&uart0 {
	pinctrl-0 = <&uart0m2_xfer_pins>;
};

&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-sdio;
	no-mmc;
	/* 卡槽 IO 固定 3.3V,无 1.8V 切换,故不开 UHS */
	max-frequency = <50000000>;
	vmmc-supply = <&vcc_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk_pins &sdmmc0_cmd_pins &sdmmc0_bus4_pins &sdmmc0_detn_pins>;
	status = "okay";
};

&gmac {
	phy-mode = "rgmii";
	/* 25MHz 由 SoC 输出给 PHY(原理图 ETH_CLK1_25M_OUT_M0 → PHY XTAL_IN) */
	clock_in_out = "output";
	assigned-clocks = <&cru CLK_MAC_OUT2IO>;
	assigned-clock-rates = <25000000>;

	snps,reset-gpio = <&gpio6 RK_PB6 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&ethm0_miim_pins
		     &ethm0_tx_bus2_pins
		     &ethm0_rx_bus2_pins
		     &ethm0_rgmii_clk_pins
		     &ethm0_rgmii_bus_pins
		     &eth_clk_25mm0_out_pins>;

	/*
	 * phy_lb_scan 千兆环回扫描实测:主窗口 RX 0x18~0x2d、TX 0x19~0x66,取几何中心。
	 * 不用工具打印的推荐值 0x46/0x38:它对所有通过点求平均,本板通过区是两块分开的岛
	 * (另一块在 RX 0x44 以上、TX 两端绕回),平均值落在空白区,实测不通过。
	 * 原先借用的 EVB 值 0x36/0x2c 的 RX 贴着窗口下沿,千兆大包丢包 25%
	 */
	tx_delay = <0x3f>;
	rx_delay = <0x22>;

	phy-handle = <&rgmii_phy>;
	status = "okay";
};

&mdio {
	/*
	 * 实测 PHY ID 0x7b744412,寄存器布局与 RTL8211F 兼容(31 号页寄存器读出 0xa42),
	 * 内核与官方 SDK 均无专用驱动,走 Generic PHY。地址由 strap 定,原理图标注默认 3'b001。
	 * clocks 必须给:PHY 的 25MHz 由 SoC 输出,没人引用这个时钟会在启动后期被关掉,
	 * 表现为 PHY ID 能读(MDIO 不依赖它)但永远 NO-CARRIER、收不到对端协商
	 */
	rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		clocks = <&cru CLK_MAC_OUT2IO>;
	};
};

&saradc0 {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

/* 以下为 SoC 内部的编解码、NPU、RGA 与温控,照官方 EVB 开启,不依赖板级外设 */
&jpegd {
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

&rga2_core0 {
	status = "okay";
};

&rga2_core0_mmu {
	status = "okay";
};

/*
 * EVB 的 rknpu-supply 来自 RK801 PMIC,本板没有 PMIC 且电源页未公开,故不设。
 * 驱动按可选电源处理(缺失时 vdd 置空继续),代价是没有 NPU 调频
 */
&rknpu {
	status = "okay";
};

&rknpu_mmu {
	status = "okay";
};

&rkvdec {
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

/* 过温保护 hw-tshut-mode 为 CRU 复位(SoC dtsi 默认),不走 GPIO,不依赖 PMIC */
&tsadc {
	status = "okay";
};

&usb2phy {
	status = "okay";
};

&usb2phy_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&usb2phy_otg {
	status = "okay";
};

&usb_host_ehci {
	status = "okay";
};

&usb_host_ohci {
	status = "okay";
};

/* USB-C OTG;板上未引出 USB3,限高速。SoC 默认同时依赖 usb3phy,不去掉会一直 deferred probe */
&usb_drd_dwc3 {
	dr_mode = "otg";
	phys = <&usb2phy_otg>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	extcon = <&usb2phy>;
	status = "okay";
};
