# RV1126B NVR 板级内核配置片段,叠加在 rv1126b_defconfig 之上。
# rv1126b_defconfig 是 IPC 精简内核(ROCKCHIP_MINI_KERNEL/BASE_SMALL),缺的东西都在这里补。
# 2026-09 在 Luckfox Aura 开发板上验证过的部分照搬(RGMII 标定工具、MPP、容器),
# SATA/USB 网口/LED/RTC 为 NVR SATA 板新增,未上真机。

# ---- 网口 ----
# RGMII delay 标定工具(sysfs 下的 rgmii_delayline / phy_lb_scan)。
# 默认随 DWMAC_ROCKCHIP 开启,但 rv1126b_defconfig 开了 ROCKCHIP_MINI_KERNEL 把它关了;
# 本板 tx/rx delay 需实测标定,借用官方 EVB 的值在千兆大包下可能丢包(Aura 实测丢 25%)
CONFIG_DWMAC_ROCKCHIP_TOOL=y
# 千兆 PHY 二选一:YT8531C(motorcomm)/ RTL8211F(realtek)。defconfig 只有内置 FEPHY,
# 两颗外置 PHY 没有专用驱动时走 Generic PHY 也能通,但 LED/时延寄存器与 RTL8211F 的
# realtek,led-lcr 都靠专用驱动
CONFIG_MOTORCOMM_PHY=y
CONFIG_REALTEK_PHY=y
# 第二网口是 USB 百兆 RTL8152B(hub 下游),与 rk3566 SATA 板相同,rootfs 按 Driver=r8152 匹配
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y

# ---- SATA 盘(JMS578 USB3-SATA 桥)----
# RV1126B 无原生 SATA,硬盘是 xhci 下的 USB 大容量存储设备;JMS578 支持 UAS。
# defconfig 连 SCSI 层都没有
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ---- 状态灯 ----
# work-led(产测 nvr-factory 驱动)与 power-led 为 gpio-leds;触发器照 rk3566 的 nvr.config:
# default-on 给常亮,timer/heartbeat/oneshot 留给运行时按需切换
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_ONESHOT=y

# ---- 编解码 ----
# 用户态 MPP(/dev/mpp_service)硬件编解码。rv1126b_defconfig 是 IPC 精简内核,只开了 MPP_OSAL;
# NVR 走 librockchip-mpp,需要 mpp_service 与对应子驱动(均认 rv1126b 专属 compatible)
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_RKVDEC2=y
CONFIG_ROCKCHIP_MPP_RKVENC2=y
CONFIG_ROCKCHIP_MPP_JPGDEC=y

# ---- 与 rk3566 共用 rootfs ----
# rv1126b_defconfig 的 BASE_SMALL 把 pid 上限压到 32768,
# Debian systemd 自带的 50-pid-max.conf 写 4194304 失败,systemd-sysctl 启动失败。
# 2GB 起步的 NVR 不需要精简核心数据结构
CONFIG_BASE_FULL=y
# systemd automount 依赖(同 nvr.config)
CONFIG_AUTOFS_FS=y

# ---- 容器与网络过滤(2026-09-19 新增) ----
# 设备要跑 Docker,并有按 cgroup 分流的脚本(依赖 iptables 的 cgroup/owner/connmark
# 等 match 与 cgroup v1 的 net_cls,net_prio)。原 defconfig 只有 IP_NF_MANGLE,
# 既无 conntrack 也无 nf_tables,ip6tables 与这些 match 全部不可用。
# 注意:net_cls/net_prio 只存在于 cgroup v1,需配合 bootargs 的
# systemd.unified_cgroup_hierarchy=0(见板级 dts),否则控制器编进去也挂不出来。
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_OVERLAY_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y

# rv1126b_defconfig 是 IPC 精简内核,连 CONFIG_NETFILTER 与 NET_NS 都没开,
# 上面那批 netfilter/容器选项会因父项缺失被整体丢弃,必须先把基座打开。
CONFIG_NET_NS=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_MANGLE=y

# nft 侧的表/链类型:Debian 的 iptables 是 nft 前端,dockerd 建 NAT 链走的是
# nftables 的 nat 表。只开 NF_TABLES 不够,实测 dockerd 报
# "TABLE_ADD failed (Operation not supported): table nat" 起不来。
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_COMPAT=y

# rv1126b_defconfig 关掉了 IPv6 与命名空间:IPv6 关着时 NF_TABLES_IPV6/IP6_NF_IPTABLES/
# NF_TABLES_INET 全部无法生成(INET 依赖 v4+v6),NET_NS 缺失则容器网络无从谈起。
CONFIG_NAMESPACES=y
CONFIG_IPV6=y

# blkio 权重限速(docker --blkio-weight)由 BFQ 提供,defconfig 未开 BFQ 时
# dockerd 启动会报 "kernel does not support cgroup blkio weight"
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y

# Docker 在 cgroup v1 下要求 cpu/cpuacct/cpuset/devices/freezer 齐全;
# 这几个在 rk3566 的 defconfig 里本就开着,rv1126b 精简内核没有,
# 缺了 dockerd 直接启动失败(实测 /proc/cgroups 只剩 blkio/memory/net_cls/net_prio/pids)
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y

# A/B 系统升级(RAUC):LOOP 挂载升级包(squashfs 已开),DM_VERITY 校验 verity 格式升级包,
# NBD 供 RAUC 边下载边安装(不落盘到 userdata)
CONFIG_BLK_DEV_LOOP=y
CONFIG_DM_VERITY=y
CONFIG_BLK_DEV_NBD=y
