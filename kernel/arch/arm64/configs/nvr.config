# NVR 板 defconfig 片段(叠加在 rockchip_linux_defconfig 上)
# HDMI 控制台便于现场调试(产测画面也靠它)。
# 必须连同 FB 与 DRM fbdev 兼容层一起开:FRAMEBUFFER_CONSOLE depends on FB,而
# rockchip_linux_defconfig 里 FB 没开,只写这一行会被 Kconfig 静默丢掉 ——
# 2026-10-20 实测 SATA 板内核 FB 未开、/dev/fb0 不存在、控制台为 dummy,HDMI 内核起来后无任何画面
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# 启动期间 HDMI 只显示 logo:fbcon 推迟到第一次有文字输出(tty1 登录提示或产测画面)才接管屏幕,
# 在此之前保留 u-boot 交接过来的 logo。配合 bootargs 不带 console=tty1(内核日志只走串口)
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# 只编 16x32 大字体:产测结果显示在 tty1 上要隔几米可读,默认 8x16 在 1080p 下太小。
# 8x16 不编进来时 fbcon 自动选用 16x32(lib/fonts/fonts.c get_default_font 按 pref 打分,
# 两者同在时 8x16 胜出),不必改 bootargs;1080p 下为 120x33 字符
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
# CONFIG_FONT_8x16 is not set
# systemd automount 依赖
CONFIG_AUTOFS_FS=y
# RK3566 是 Mali-G52(Bifrost),另外两个 Mali 家族用不到:
# mali400/450 是 Utgard(会空跑 module_init 打印 "Mali device driver loaded" 干扰排查),
# midgard 是 T 系列。base defconfig 开着它们是为了一份配置服务多颗芯片。
CONFIG_MALI400=n
CONFIG_MALI450=n
CONFIG_MALI_MIDGARD=n
# 本板无 WiFi/BT 硬件,裁剪无线协议栈和全部 WiFi 驱动
# WL_ROCKCHIP 会 select CFG80211/MAC80211,必须一并关闭
CONFIG_WL_ROCKCHIP=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
# LED 触发器:defconfig 没开,dts 里 work-led 的 linux,default-trigger 被整个忽略,
# 系统灯一直不亮。default-on 给系统灯常亮,timer/heartbeat/oneshot 留给运行时按需切换
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_ONESHOT=y
# vendor storage 只用 eMMC 后端;MTD 后端编进去后因无 SPI flash 永远 deferred probe pending,
# 每次开机在 12 秒处多打一行且拖慢 udev-settle
CONFIG_ROCKCHIP_MTD_VENDOR_STORAGE=n

# ---- 容器与网络过滤(2026-09-19 新增) ----
# 设备要跑 Docker,并有按 cgroup 分流的脚本(依赖 iptables 的 cgroup/owner/connmark
# 等 match 与 cgroup v1 的 net_cls,net_prio)。原 defconfig 只有 IP_NF_MANGLE,
# 既无 conntrack 也无 nf_tables,ip6tables 与这些 match 全部不可用。
# 注意:net_cls/net_prio 只存在于 cgroup v1,需配合 bootargs 的
# systemd.unified_cgroup_hierarchy=0(见板级 dts),否则控制器编进去也挂不出来。
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_OVERLAY_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y

# nft 侧的表/链类型:Debian 的 iptables 是 nft 前端,dockerd 建 NAT 链走的是
# nftables 的 nat 表。只开 NF_TABLES 不够,实测 dockerd 报
# "TABLE_ADD failed (Operation not supported): table nat" 起不来。
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_COMPAT=y

# blkio 权重限速(docker --blkio-weight)由 BFQ 提供,defconfig 未开 BFQ 时
# dockerd 启动会报 "kernel does not support cgroup blkio weight"
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y

# RTC 用外挂 HYM8563(SATA 板,有纽扣电池备电),不要 RK809 内置那颗(无备电,断电一夜即丢时间)。
# 两颗同时注册时 RK809 先抢走 rtc0,hctosys/systohc 会落到它上面,只能从驱动层关掉。
# 无 SATA 板没有 RK809,不受影响
# CONFIG_RTC_DRV_RK808 is not set

# device-mapper 内置(只要核心 + uevent,不开具体 target)
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_UEVENT=y

# A/B 系统升级(RAUC):LOOP 挂载升级包(squashfs 已开),DM_VERITY 校验 verity 格式升级包,
# NBD 供 RAUC 边下载边安装(不落盘到 userdata)
CONFIG_BLK_DEV_LOOP=y
CONFIG_DM_VERITY=y
CONFIG_BLK_DEV_NBD=y
