# NVR 板 defconfig 片段(叠加在 rockchip_linux_defconfig 上)
# HDMI 控制台便于现场调试
CONFIG_FRAMEBUFFER_CONSOLE=y
# systemd automount 依赖
CONFIG_AUTOFS_FS=y
# RK3566 是 Mali-G52(Bifrost),另外两个 Mali 家族用不到:
# mali400/450 是 Utgard(会空跑 module_init 打印 "Mali device driver loaded" 干扰排查),
# midgard 是 T 系列。base defconfig 开着它们是为了一份配置服务多颗芯片。
CONFIG_MALI400=n
CONFIG_MALI450=n
CONFIG_MALI_MIDGARD=n
# 本板无 WiFi/BT 硬件,裁剪无线协议栈和全部 WiFi 驱动
# WL_ROCKCHIP 会 select CFG80211/MAC80211,必须一并关闭
CONFIG_WL_ROCKCHIP=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
# LED 触发器:defconfig 没开,dts 里 work-led 的 linux,default-trigger 被整个忽略,
# 系统灯一直不亮。default-on 给系统灯常亮,timer/heartbeat/oneshot 留给运行时按需切换
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_ONESHOT=y
# vendor storage 只用 eMMC 后端;MTD 后端编进去后因无 SPI flash 永远 deferred probe pending,
# 每次开机在 12 秒处多打一行且拖慢 udev-settle
CONFIG_ROCKCHIP_MTD_VENDOR_STORAGE=n
