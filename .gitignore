# nvr-os 单仓忽略规则
#
# 本仓由 repo 多仓库结构收敛而来(2026-09-09):各子仓的 .git 已拆除,
# 独立历史保存在 /data/backup/nvr-os-subrepos-20260909/ 的 bundle 里。
# 各子目录自带的 .gitignore(kernel/、u-boot/、buildroot/ 等)仍然生效,
# 内核与 u-boot 的编译产物由它们自己排除,这里只列它们管不到的部分。

# ---- repo 工具元数据(已失效,Gerrit 无账号不可 sync)----
/.repo/

# ---- 构建产物 ----
/rockdev/
/buildroot/output/
/buildroot/dl/
/debian/binary/
/debian/linaro-rootfs.img
/debian/*.ext4
/br.log
/kernel/boot.img
/kernel/vmlinux
/kernel/vmlinux.o

# ---- 构建缓存(可重新生成,体积大)----
/debian/bookworm-base-arm64.tar.gz

# ---- 体积过大且可另行获取的二进制 ----
# 说明见 README「最小可构建集」一节:克隆后需要补齐 prebuilts/gcc 与
# debian/overlay-firmware 才能完整构建 rootfs 与内核。
/prebuilts/gcc/
/debian/overlay-firmware/
# nvr-edge 出厂基线:40M 二进制,每换一版仓库就多一份历史。
# 由 debian/sync-nvr-edge.sh 从 nvr-edge 的 `make baseline` 产物装入(集成约定第 6 节),
# VERSION 一并排除,避免它与本地实际装着的二进制对不上
/debian/overlay-nvr/usr/local/lib/nvr/nvr-edge
/debian/overlay-nvr/usr/local/lib/nvr/VERSION
/external/rknpu2/
/external/rknn-toolkit2/
/external/security/
/docs/Common/
# Windows 烧写工具,与 tools/windows/ 内容部分重复
/RKDevTool_Release_v3.19/

# 原厂 SDK 压缩包(每个 10G 量级),只作比对来源,不入库
/debian/*.tar.gz
!/debian/bookworm-base-arm64.tar.gz
/tools/windows/

# ---- 编辑器与临时文件 ----
*.swp
*~
.DS_Store

# 构建中间目录
/.rootfs/
