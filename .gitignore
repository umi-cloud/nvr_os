# nvr-os 单仓忽略规则
#
# 本仓由 repo 多仓库结构收敛而来(2026-09-09):各子仓的 .git 已拆除,
# 独立历史保存在 /data/backup/nvr-os-subrepos-20260909/ 的 bundle 里。
# 各子目录自带的 .gitignore(kernel/、u-boot/、buildroot/ 等)仍然生效,
# 内核与 u-boot 的编译产物由它们自己排除,这里只列它们管不到的部分。

# ---- repo 工具元数据(已失效,Gerrit 无账号不可 sync)----
/.repo/

# ---- 构建产物 ----
/rockdev/
/buildroot/output/
/buildroot/dl/
/debian/binary/
/debian/linaro-rootfs.img
/debian/*.ext4
/br.log
/kernel/boot.img
/kernel/vmlinux
/kernel/vmlinux.o

# ---- 构建缓存(可重新生成,体积大)----
/debian/bookworm-base-arm64.tar.gz

# ---- 体积过大且可另行获取的二进制 ----
# 说明见 README「最小可构建集」一节:克隆后需要补齐 prebuilts/gcc 与
# debian/overlay-firmware 才能完整构建 rootfs 与内核。
/prebuilts/gcc/
/debian/overlay-firmware/
/external/rknpu2/
/external/rknn-toolkit2/
/external/security/
/docs/Common/
# Windows 烧写工具,与 tools/windows/ 内容部分重复
/RKDevTool_Release_v3.19/

# tools/ 只保留构建与烧写必需的两块,其余(签名工具 85M、安全启动套件 19M、
# 未被任何脚本引用的 boot_merger/programmer_image_tool 等)不入库:
#   Linux_Pack_Firmware  build.sh updateimg 的 PACK_TOOL_DIR,内含
#                        我们的 rk356x-nvr-package-file 打包清单
#   Linux_Upgrade_Tool   v2.17 烧写工具(v1.54 的那个连 update.img 都解析不了)
/tools/*
!/tools/linux/
/tools/linux/*
!/tools/linux/Linux_Pack_Firmware/
!/tools/linux/Linux_Upgrade_Tool/

# ---- 编辑器与临时文件 ----
*.swp
*~
.DS_Store

# 构建中间目录
/.rootfs/
